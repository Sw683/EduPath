# ==============================================================================
# EduPath Environment Variables Template
# Copy this file to .env and fill in your local or production values.
# NEVER commit your actual .env file to version control.
# ==============================================================================

# Server Configuration
PORT=3000
NODE_ENV=development

# Session Encryption Secret
# Generate a strong, cryptographically random secret string in production:
# e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your_session_secret_here

# PostgreSQL Database Connection URL
# Format: postgresql://<username>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://your_db_user:your_db_password@localhost:5432/edupath_db

# Optional: Individual PostgreSQL connection parameters (if DATABASE_URL is omitted)
# PGHOST=localhost
# PGPORT=5432
# PGUSER=your_db_user
# PGPASSWORD=your_db_password
# PGDATABASE=edupath_db

# Optional: PostgreSQL SSL / TLS Configuration
# Set to 'true' when connecting to cloud providers (e.g. AWS RDS, Neon, Supabase)
# DATABASE_SSL=false
# Optional: Provider CA Certificate string (PEM format) or path to root certificate
# DATABASE_CA_CERT=
# PGSSLROOTCERT=

# Google OAuth 2.0 Credentials (Optional: obtain from Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Community Resource Moderation Admin Key (Header: x-admin-key)
ADMIN_KEY=your_admin_secret_key_here
